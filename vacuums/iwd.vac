voidname=iwd
voidver=3.12
voidrev=1
voiddesc="Wireless daemon for Linux"
voiddeps=(readline,dbus)
voidbuilddeps=(readline,dbus,ncurses)
voidlicense="GPL-2.0"
voidmaintainer="Alexandr Vod <a.e.vodolagin@yandex.ru>"
voidhome="https://git.kernel.org/pub/scm/network/wireless/iwd.git/about/"
voidurl="https://mirrors.edge.kernel.org/pub/linux/network/wireless/iwd-${voidver}.tar.gz"
voidsum=81a12fd4a03dd8e3d60c72b19767507c913f4b0fa4e5fc4ef5ed3f5ffae178dd

build_void() {
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-systemd-service \
        LIBS="-lncurses"
    make -j$(nproc)
}

install_void() {
    make DESTDIR=$DESTDIR install
}
