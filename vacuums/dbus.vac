voidname=dbus
voidver=1.16.2
voidrev=1
voiddeps=(libexpat)
voidbuilddeps=(meson)
voiddesc="D-Bus is a message bus system, a simple way for applications to talk to one another. In addition to interprocess communication, D-Bus helps coordinate process lifecycle; it makes it simple and reliable to code a \"single instance\" application or daemon, and to launch applications and daemons on demand when their services are needed."
voidlicense="GPL-2.0"
voidmaintainer="Alexandr Vod <a.e.vodolagin@yandex.ru>"
voidhome="https://www.freedesktop.org/wiki/Software/dbus"
voidurl="https://gitlab.freedesktop.org/dbus/dbus/-/archive/dbus-${voidver}/dbus-dbus-${voidver}.tar.gz"
voidsum=d77cc71acd93e85f2bd2a6fe3a40e5bd023519e3e9fa9b5361e7109f42b74060

build_void() {
    meson build
    meson configure build/ \
        -Dprefix=/usr \
        -Dlibdir=lib \
        -Dxml_docs=disabled
    cd build
    meson compile
}

install_void() {
    DESTDIR=$DESTDIR meson install
    cd ..
}
