voidname=meson
voidver=1.11.2
voidrev=1
voiddesc="The Meson Build System"
voiddeps=(ninja)
voidbuilddeps=(python)
voidmaintainer="Alexandr Vod <a.e.vodolagin@yandex.ru>"
voidlicense="Apache-2.0"
voidhome="https://mesonbuild.com"
voidurl="https://github.com/mesonbuild/meson/releases/download/${voidver}/meson-${voidver}.tar.gz"
voidsum=698feae069cef3ecd4d7aaf281d7df359bdfcf555a9a1564383d3b913fa8a736

build_void() {
    true
}

install_void() {
    install -dm755 "$DESTDIR/usr/lib/meson"
    cp -r mesonbuild "$DESTDIR/usr/lib/meson/"

    install -dm755 "$DESTDIR/usr/bin"
    cat << 'EOF' > "$DESTDIR/usr/bin/meson"
#!/usr/bin/env python3
import sys
import os

sys.path.insert(0, '/usr/lib/meson')

from mesonbuild.mesonmain import main
if __name__ == '__main__':
    sys.exit(main())
EOF
    chmod +x "$DESTDIR/usr/bin/meson"
}
